<?xml version="1.0" encoding="utf-8"?>
<!-- Nexus on Android: a NativeActivity that loads the app (libnexus_app.so). There is no Java code.
     The version and SDK levels are filled in by scripts/package-android.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.nexus.terminal">
    <!-- SSH to your machines, the Tailscale API, update checks, phone alerts. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <!-- Works with a hardware keyboard and mouse (tablets, Chromebooks, DeX) as well as touch. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Settings, SSH keys and the Tailscale credential stay on the device: no cloud backup, no device transfer. -->
    <application
        android:label="Nexus"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- configChanges: rotation, a keyboard appearing or a resize is handled by the app, not by restarting it.
             adjustResize: the on-screen keyboard takes space from the terminal instead of covering it. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="nexus_app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
